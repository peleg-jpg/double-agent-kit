{
  "name": "motion-gsap-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Hebrew RTL explainer B-roll scenes (9:16) built from HTML + GSAP, rendered to MP4 with headless Chrome",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "preview": "node scripts/preview.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "check": "node scripts/check.mjs",
    "hf:render": "node scripts/sync.mjs && npx -y hyperframes@0.8.113 render -o out/explainer-hf.mp4"
  },
  "dependencies": {
    "@fontsource/assistant": "5.3.0",
    "@fontsource/heebo": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@fontsource/secular-one": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.15.0",
    "puppeteer": "25.12.0"
  }
}
